{
  "name": "whistl-workspace",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node init && turbo run dev",
    "build": "node init && turbo run build && cp -R apps/trader/.next ./.next",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
